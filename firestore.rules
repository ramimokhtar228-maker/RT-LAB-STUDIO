rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /bookings/{bookingId} {
      allow read, write: if isValidId(bookingId);
    }

    match /orders/{orderId} {
      allow read, write: if isValidId(orderId);
    }

    match /settings/{settingsId} {
      allow read, write: if isValidId(settingsId);
    }

    // Multi-device sync collections (lab_tests, lab_staff, lab_accounts, lab_meta, ...)
    match /{col}/{docId} {
      allow read, write: if col.matches('lab_.*') && isValidId(docId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
